{
  "name": "editify",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "server"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint:copy": "node scripts/check-em-dashes.mjs",
    "dev:server": "npm run dev -w @editify/server",
    "dev:mobile": "npm run start -w @editify/mobile",
    "dev:mobile:ios": "npm run ios -w @editify/mobile",
    "dev:mobile:android": "npm run android -w @editify/mobile",
    "seed": "npm run seed -w @editify/server",
    "repro": "npm run repro -w @editify/server --"
  },
  "engines": {
    "node": ">=20"
  }
}
