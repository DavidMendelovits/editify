{
  "expo": {
    "name": "Editify",
    "slug": "editify",
    "owner": "dfordavey",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "editify",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E0E10"
    },
    "updates": {
      "url": "https://u.expo.dev/05e74ce6-1ff5-426f-9988-98665619839d"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "bundleIdentifier": "com.editify.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.editify.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E0E10"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.481295230846-p9b26huakkve0r2qft6uggtebgaut81t"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Editify adds clips from your photo library to the timeline.",
          "cameraPermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Editify records voiceover takes straight onto the timeline."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "05e74ce6-1ff5-426f-9988-98665619839d"
      }
    }
  }
}
