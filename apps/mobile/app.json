{
  "expo": {
    "name": "Editify",
    "slug": "editify",
    "owner": "editify",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "editify",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E0E10"
    },
    "updates": {
      "url": "https://u.expo.dev/901bf170-2dbf-4ff7-ae24-68218ac5d18c"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "bundleIdentifier": "com.editify.app",
      "appleTeamId": "F9R8TK7W79",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "Editify transcribes your clips on this iPhone to make captions and find cuts."
      }
    },
    "android": {
      "package": "com.editify.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E0E10"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.481295230846-p9b26huakkve0r2qft6uggtebgaut81t"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Editify adds clips from your photo library to the timeline.",
          "cameraPermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Editify records voiceover takes straight onto the timeline."
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": "SUBQUERY (extensionItems, $extensionItem, SUBQUERY ($extensionItem.attachments, $attachment, ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO \"public.movie\" || ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO \"public.audio\").@count >= 1).@count >= 1",
          "disableAndroid": true
        }
      ],
      "./plugins/with-share-audio",
      [
        "posthog-react-native/expo",
        {
          "uploadNativeSymbols": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.0"
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "901bf170-2dbf-4ff7-ae24-68218ac5d18c"
      }
    }
  }
}
