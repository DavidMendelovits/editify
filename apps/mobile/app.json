{
  "expo": {
    "name": "Editify",
    "slug": "editify",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "editify",
    "userInterfaceStyle": "dark",
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      ["expo-image-picker", { "photosPermission": "Editify adds clips from your photo library to the timeline." }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
