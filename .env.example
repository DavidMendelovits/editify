PORT=3001
PUBLIC_BASE_URL=http://localhost:3001
# The agent runs on the Anthropic API. Without a key it falls back to the
# deterministic offline mock, which is only meant for local dev and tests.
# ANTHROPIC_API_KEY=
# Mobile bundling reads this variable:
EXPO_PUBLIC_API_URL=http://localhost:3001

# Lets error and feedback reports open GitHub issues on DavidMendelovits/editify.
# Unset (as here) writes them to server/data/user-insights.md instead.
# GITHUB_TOKEN=

# --- Deployment only ---
# Shared password. Unset (as here) leaves the server open, which is what local
# development wants; set it anywhere the server is reachable from the internet.
# EDITIFY_TOKEN=
# The same value in the phone client, so its requests and media loads carry it.
# EXPO_PUBLIC_API_TOKEN=
# Where SQLite, uploads, proxies, and renders live. Defaults to server/data.
# EDITIFY_DATA_DIR=/data
# An `expo export --platform web` build to serve from the API's own origin.
# EDITIFY_WEB_DIR=/app/apps/mobile/dist

# --- Subscriptions ---
# RevenueCat public SDK keys, from the project's API keys page. Unset (as here)
# turns the paywall off and leaves everyone on the free tier: see
# docs/subscriptions.md for the products and prices to create first.
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
